# Copy these non-secret settings into .env for the local Evidence Copilot.
# Authentication uses Google Application Default Credentials, not credentials here.
GOOGLE_CLOUD_PROJECT=PASTE_YOUR_GOOGLE_CLOUD_PROJECT_ID_HERE
GOOGLE_CLOUD_LOCATION=global
AERO_PSI_VERTEX_MODEL=gemini-3.5-flash
AERO_PSI_COPILOT_ENABLED=true
